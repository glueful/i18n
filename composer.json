{
    "name": "glueful/i18n",
    "description": "Localization primitives for Glueful apps and extensions.",
    "type": "glueful-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Tawiah Sowah",
            "email": "michael@glueful.dev"
        }
    ],
    "keywords": [
        "glueful",
        "i18n",
        "localization",
        "translations"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "glueful/framework": "^1.79",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "suggest": {
        "ext-intl": "Enables ICU MessageFormat pluralization with full CLDR plural rules."
    },
    "homepage": "https://github.com/glueful/i18n",
    "autoload": {
        "psr-4": {
            "Glueful\\Extensions\\I18n\\": "src/"
        },
        "classmap": [
            "migrations/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Glueful\\Extensions\\I18n\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyze": "vendor/bin/phpstan analyse",
        "phpcbf": "vendor/bin/phpcbf --standard=PSR12 src",
        "phpcs": "vendor/bin/phpcs --standard=PSR12 src",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "glueful": {
            "name": "I18n",
            "displayName": "I18n",
            "description": "Localization primitives for Glueful apps and extensions.",
            "version": "1.1.1",
            "categories": [
                "localization",
                "content"
            ],
            "publisher": "glueful-team",
            "provider": "Glueful\\Extensions\\I18n\\I18nServiceProvider",
            "requires": {
                "glueful": ">=1.79.0",
                "extensions": []
            },
            "migrations": [
                {
                    "id": "default",
                    "path": "migrations",
                    "priority": "default",
                    "mode": "on_enable",
                    "verifier": "Glueful\\Extensions\\I18n\\Schema\\I18nSchemaVerifier"
                }
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
